# ──────────────────────────────────────────────
# DSU Faculty Research Intelligence System
# Environment Variables
# ──────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://dsu_admin:dsu_secure_2026@localhost:5432/dsu_research?schema=public"

# JWT Authentication
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Backend
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV="development"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ORCID API (configure when ready)
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_API_URL="https://pub.orcid.org/v3.0"

# Scopus / Elsevier API (requires DSU institutional key)
SCOPUS_API_KEY=""
SCOPUS_API_URL="https://api.elsevier.com"

# File storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Redis (for background jobs - Phase 5)
REDIS_URL="redis://localhost:6379"
